<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MrCWarehouse" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/primary</item>
        <item name="colorOnPrimary">@color/text_on_primary</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSurface">@color/bg_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:statusBarColor">@color/primary_dark</item>
        <item name="android:navigationBarColor">@color/bg_nav</item>
        <item name="android:windowBackground">@color/bg_main</item>
        <item name="materialCardViewStyle">@style/CardView.Solid</item>
    </style>

    <!-- Alert dialog theme - full width -->
    <style name="Theme.MrCWarehouse.Dialog" parent="ThemeOverlay.Material3.Dialog">
        <item name="android:windowBackground">@color/bg_card</item>
        <item name="colorSurface">@color/bg_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_primary</item>
    </style>

<!-- Solid card style with no transparency -->
    <style name="CardView.Solid" parent="Widget.Material3.CardView.Filled">
        <item name="cardElevation">2dp</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardBackgroundColor">@color/bg_card</item>
        <item name="strokeColor">@android:color/transparent</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <!-- Solid outlined card -->
    <style name="CardView.Outlined" parent="Widget.Material3.CardView.Outlined">
        <item name="cardElevation">0dp</item>
        <item name="cardCornerRadius">14dp</item>
        <item name="cardBackgroundColor">@color/bg_card</item>
        <item name="strokeColor">@color/divider</item>
        <item name="strokeWidth">1dp</item>
    </style>

</resources>