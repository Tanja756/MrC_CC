<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/bg_card"
    android:padding="20dp">

    <TextView
        android:id="@+id/tvDialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Завершение заявки"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Для завершения заполните комментарий или прикрепите хотя бы один файл"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <!-- Location status indicator -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        android:background="@color/bg_input"
        android:padding="12dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📍 Местоположение:"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvLocationStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Определяется..."
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Comment input -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/commentLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:hint="Комментарий"
        app:boxBackgroundColor="@color/bg_input"
        app:boxBackgroundMode="filled"
        app:boxCornerRadiusBottomEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusTopStart="12dp"
        app:boxStrokeColor="@color/input_stroke"
        app:hintTextColor="@color/text_hint">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etComment"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="top|start"
            android:inputType="textMultiLine"
            android:maxLines="6"
            android:minLines="3"
            android:padding="14dp"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Attached files header -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Прикреплённые файлы:"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- Add file button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAddFile"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginTop="10dp"
        android:text="Добавить PDF"
        android:textAllCaps="false"
        android:textColor="@color/primary"
        android:textSize="12sp"
        android:textStyle="bold"
        app:backgroundTint="@color/primary_surface"
        app:cornerRadius="10dp"
        app:icon="@android:drawable/ic_menu_add"
        app:iconGravity="textStart"
        app:iconSize="16dp"
        app:iconTint="@color/primary" />

    <!-- Files list -->
    <LinearLayout
        android:id="@+id/filesContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical" />

    <!-- Validation error -->
    <TextView
        android:id="@+id/tvValidationError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Необходимо добавить комментарий или прикрепить хотя бы один файл"
        android:textColor="@color/status_error"
        android:textSize="12sp"
        android:visibility="gone" />

</LinearLayout>